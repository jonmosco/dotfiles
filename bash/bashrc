# =============================================================================
# 1. Shell settings
# =============================================================================
set -o noclobber

shopt -s cmdhist
shopt -s checkhash
shopt -s histappend
shopt -s checkwinsize
shopt -s cdspell
shopt -s extglob

# =============================================================================
# 2. PATH (before anything that uses hash/command -v)
# =============================================================================
for files in ~/.{path,exports}; do
  if [[ -r "$files" ]] && [[ -f "$files" ]]; then
    # shellcheck disable=SC1090
    source "$files"
  fi
done

# =============================================================================
# 3. Environment variables
# =============================================================================
export EDITOR=nvim

# Set OS specific settings
OSTYPE=$(uname)
case $OSTYPE in
  Darwin)
    if [ ! -d /usr/local/opt/coreutils ]; then
        export CLICOLOR=1
        export LSCOLORS=gxfxbEaEBxxEhEhBaDaCaD
    fi
    ;;
  *BSD)
    if [ -e /usr/local/bin/colors ]; then
      export LSCOLORS=GxFxCxDxBxDxDxxbadacad
      alias ls='colorls -FG'
    fi
    ;;
esac

export LESS='-R -i -g'
export LESS_TERMCAP_mb=$'\E[01;31m'
export LESS_TERMCAP_md=$'\E[01;38;5;74m'
export LESS_TERMCAP_me=$'\E[0m'
export LESS_TERMCAP_se=$'\E[0m'
export LESS_TERMCAP_so=$'\E[38;5;246m'
export LESS_TERMCAP_ue=$'\E[0m'
export LESS_TERMCAP_us=$'\E[04;38;5;146m'

export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/ssh-agent.socket"

export FZF_CTRL_R_OPTS="--reverse"
export FZF_TMUX_OPTS="-p"

# =============================================================================
# 4. Aliases and functions
# =============================================================================
for files in ~/.{aliases,dockerfunctions,functions}; do
  if [[ -r "$files" ]] && [[ -f "$files" ]]; then
    # shellcheck disable=SC1090
    source "$files"
  fi
done

# =============================================================================
# 5. Prompt
# =============================================================================
if [[ -r ~/.bash_prompt ]] && [[ -f ~/.bash_prompt ]]; then
  # shellcheck disable=SC1090
  source ~/.bash_prompt
fi

# =============================================================================
# 6. Completions (lazy-loaded by bash-completion framework)
# =============================================================================
# Completions for kubectl, gh, oc live in ~/.local/share/bash-completion/completions/
# and are loaded on first tab-complete, not at startup.
if [[ -r /usr/share/bash-completion/bash_completion ]]; then
  . /usr/share/bash-completion/bash_completion
fi

complete -C /usr/bin/vault vault

# =============================================================================
# 7. Tool init
# =============================================================================
if [[ -r ~/.dircolors ]]; then
  eval "$(dircolors ~/.dircolors)"
  alias ls='ls -F --color=auto'
fi

if [ -x "$(command -v fzf)" ]; then
  source /usr/share/fzf/shell/key-bindings.bash
fi

[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

if [ -f "$HOME/.bash-git-prompt/gitprompt.sh" ]; then
    GIT_PROMPT_ONLY_IN_REPO=1
    source $HOME/.bash-git-prompt/gitprompt.sh
fi

[[ -f ~/.bash-preexec.sh ]] && source ~/.bash-preexec.sh

# Confirm we want to exit when in a container to avoid losing all the work
if [ -f /.dockerenv ]; then
  set -o ignoreeof
fi

# =============================================================================
# 8. Local overrides (not in source control)
# =============================================================================
[[ -f ~/.work_env ]] && source ~/.work_env

# opencode
export PATH=/home/jmosco/.opencode/bin:$PATH

complete -C /usr/bin/hcp hcp
