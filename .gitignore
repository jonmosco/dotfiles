mutt/cache
mutt/personal/
mutt/sig
mutt/temp
mutt/offlineimap.pyc
tmux/.config/tmux/plugins/*
!tmux/.config/tmux/plugins/tpm
zsh/local*
vim/bundle/
third_party/*

nvim/.config/nvim/lua/personal-projects/

# Machine-generated nvim runtime state. ~/.local/share/nvim/site is stowed
# into this repo, so :TSUpdate writes compiled parsers (13 MB) and
# absolute-path query symlinks straight into the working tree. Parsers are
# rebuilt by the nvim-treesitter build step, so none of it belongs in git.
nvim/.local/

# Dracula Pro is a paid theme; never commit it to this public repo.
# (The nvim copy sits under the ignored nvim/.local/ tree above.)
ghostty/.config/ghostty/themes/dracula-pro
ghostty/.config/ghostty/theme-local.conf

# Local-only stow package: AI agent instruction files. Kept out of this public
# repo because the skills reference internal workflows. The Makefile skips any
# package that is absent, so `make stow` still works without it.
agents/

# Local overrides (may contain secrets — never commit)
.work_env
work_env

# Local editor/agent settings
.claude/

# Generated or machine-specific runtime config
quickshell/.config/quickshell/keybindings.json
quickshell/.config/quickshell/wallpaper.conf
quickshell/.config/quickshell/theme-switcher/wallpaper-theme.json
hyprland/.config/hypr/monitors.conf
hyprland/.config/hypr/theme-borders.conf
