theme = Dracula+
#theme = Rose Pine
font-family = Hack Nerd Font Mono
font-size = 14
gtk-single-instance = true
gtk-titlebar = false
window-decoration = none
class = ghostty
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true

# Dracula Pro is a paid theme and cannot be committed to this public repo, so
# the theme above is a built-in fallback. The optional include below (the "?"
# suppresses the error when it is absent) overrides it with Pro on machines
# that have it. Included files load after this one, so the override wins
# regardless of where this line sits.
config-file = ?theme-local.conf
